# Copy to .env.local for `npm run dev` (Vite loads VITE_* at dev/build time).
# FastAPI default in this repo is port 8000 — use the same port your `run.py` / uvicorn uses.

# Required when the UI and API are on different origins (typical: Vite :5173, API :8000).
# Must be a FULL URL (http:// or https://). Relative paths like "/" break API calls (you get HTML + JSON errors).
VITE_API_BASE=http://127.0.0.1:8000

# Optional: same value as server DASHBOARD_READ_TOKEN — or paste in the dashboard banner (stored in localStorage).
# VITE_DASHBOARD_READ_TOKEN=

# Optional: same value as server API_CONTROL_TOKEN. Required by Start/Stop/Mode/Capital writes when configured.
# VITE_API_CONTROL_TOKEN=
