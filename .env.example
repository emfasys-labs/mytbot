# .env.example
# =============
# Copy this to .env and fill in your real credentials.
# NEVER commit .env to git. It is in .gitignore.
#
# Full new-machine walkthrough (Python, Docker, Ollama/LLMs, UI, keys):
#   docs/NEW_MACHINE_SETUP.md
#
# cp .env.example .env

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=paper                   # "paper" or "live" — controls all broker modes
LOG_LEVEL=INFO

# ── System (run.py) ──────────────────────────────────────────────────────────
# python run.py — starts everything. These are optional overrides:
# API_HOST=0.0.0.0             # API listen address
# API_PORT=8000                # API listen port
# PORTFOLIO_VALUE=100000       # Starting portfolio value (USD)
# LOOP_INTERVAL_SEC=120        # Trading loop interval
# EXECUTION_AUTO_KILL_GLOBAL=0  # 1 = API/reconciliation auto-fail uses global kill; 0 = disable affected broker only
# HTTP_CLIENT_MAX_ATTEMPTS=5    # NewsAPI/FRED httpx_get_with_retry ceiling
# TIMEFRAME=1h                 # Feature timeframe (must match pipeline)
# PIPELINE_INTERVAL_SEC=3600   # Data pipeline run interval

# ── D015 dynamic allocator ─────────────────────────────────────────────────────
# Default: D015 primary path is ON (batch opportunity → allocation → plan → risk → execution).
# ALLOCATOR_D015_LEGACY_FALLBACK=true  # restore legacy per-symbol signal → risk → execution (emergency / comparison)
# ALLOCATOR_D015_SHADOW=true           # with legacy fallback: log shadow D015 summary per signal
# ALLOCATOR_D015_ENABLED=true          # only used when LEGACY_FALLBACK is true: narrow duplicate risk checks

# ── Global edge coordinator + arbitrage (see config/global_edge.yaml, strategies.yaml, risk_limits.yaml) ──
ENABLE_ARBITRAGE=true                  # master: run funding + cross-exchange scans in the loop when strategies enable them
GLOBAL_EDGE_COORDINATOR=true           # coordinator path on (also toggled by config/global_edge.yaml enabled)

# ── M7 Dashboard API (optional) ─────────────────────────────────────────────
# API_CONTROL_TOKEN=            # required for mutating routes if set (header: X-Control-Token)
# API_ALLOWED_ORIGINS=http://localhost:5173
# DASHBOARD_READ_TOKEN=          # if set, all GET/POST except /healthz need X-Dashboard-Token (or WS ?token=)
# DASHBOARD_PASSWORD=            # optional: POST /auth/dashboard/login {password} → returns read token
# ALLOW_MISSING_DASHBOARD_READ_TOKEN_LIVE=0  # set 1 only for local dev if APP_ENV=live without read token (API startup)
# RISK_PARAMETER_OVERRIDES_PATH=config/risk_parameter_overrides.yaml
# CONTROL_COMMAND_POLL_SEC=2     # trading loop: how often to process DB control commands (kill, set_parameter, …)
# DOCKER_COMPOSE_UP_ATTEMPTS=3     # dependency_manager: retries for `docker compose up -d` (db / redis)
# IBKR_PLACE_ORDER_RETRY_JITTER_SEC=0.5  # execution: extra random delay (seconds) on IBKR place_order retries
# M8_GBP_USD_RATE=1.25         # optional: USD per 1 GBP for M8 GBP notional cap

# ── M1 main.py ────────────────────────────────────────────────────────────────
# Concurrent IBKR + Kraken price streams; optional Timescale tick + order logging.
# M1_ENABLE_IBKR=true
# M1_ENABLE_KRAKEN=true
# M1_IBKR_SYMBOLS=BTC
# M1_KRAKEN_SYMBOLS=BTC/USD,ETH/USD
# M1_IBKR_PLACE_ORDER=0          # 1 = after delay, one tiny paper crypto MKT (IOC) + orders row
# M1_IBKR_ORDER_DELAY_SEC=20
# M1_IBKR_ORDER_SYMBOL=BTC
# M1_IBKR_ORDER_QTY=0.001

# ── IBKR ─────────────────────────────────────────────────────────────────────
# TWS must be running locally. Enable API in TWS settings.
# APP_ENV=paper|live controls default mode in test_ibkr.py
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                  # 7497=paper, 7496=live (test_ibkr.py --paper uses 7497 unless IBKR_PAPER_PORT is set)
# IBKR_PAPER_PORT=7497            # optional: override paper socket for test_ibkr.py --paper only
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=                # Your IBKR account ID (e.g. DUP694288 / DU1234567 for paper); required if managedAccounts() order != the account you want
# IBKR_MAX_SYNCED_SUB_ACCOUNTS=0  # default 0: skip ib_insync multi-account sync (avoids Error 321 on paper); set 50 for FA subaccounts
# IBKR_CONNECT_TIMEOUT=45         # adapter default 45s (was 15); lower only if you want faster fail when Gateway is down
# IBKR_CONNECT_BOOST_TIMEOUT=90   # second connect attempt uses max(this, IBKR_CONNECT_TIMEOUT) if summary probe fails
# IBKR_POST_CONNECT_SUMMARY_PROBE=1  # 0=disable probe+boost reconnect
# IBKR_POST_CONNECT_SUMMARY_PROBE_TIMEOUT=12  # seconds to wait for reqAccountSummary during probe
# IBKR_CONNECT_READONLY=0         # 1 = lighter connect (skip open/completed order sync)
# IBKR_ACCOUNT_SUMMARY_TIMEOUT=30 # seconds for get_balance accountSummaryAsync; on timeout returns empty list
# IBKR_ACCOUNT_SUMMARY_TAGS=      # optional: override summary tags (comma-separated). Default is minimal to avoid hangs.
# IBKR_ACCOUNT_SUMMARY_INCLUDE_LEDGER=0  # 1 to include $LEDGER:ALL (slower; can stall on some Gateway sessions)
# IBKR_ORDER_REFRESH_TIMEOUT=15   # get_order: reqOpenOrders + reqExecutions wait ceiling (seconds each)
# IBKR_ORDER_REFRESH_MIN_SEC=2    # debounce between snapshot pulls (polling scripts)

# ── IBKR options (single-leg; disabled by default — see config/risk_limits.yaml options_trading) ──
# ENABLE_OPTIONS=false
# OPTIONS_ALLOWED_UNDERLYINGS=SPY
# OPTIONS_MAX_PREMIUM_PER_TRADE=200
# OPTIONS_MAX_CONTRACTS_PER_TRADE=1
# OPTIONS_MAX_TOTAL_PREMIUM_EXPOSURE=500
# OPTIONS_PAPER_ONLY=true
# OPTIONS_ALLOW_SHORT=false
# OPTIONS_ALLOW_SELL_TO_CLOSE=true
# SMOKE_OPTIONS_UNDERLYING=SPY
# MYTBOT_IBKR_OPTIONS_PLACE_ORDER=0   # 1 = scripts/smoke_ibkr_options.py may submit a tiny limit BUY

# ── Kraken ────────────────────────────────────────────────────────────────────
# Generate at: Account → Security → API
# Permissions needed: Query Funds, Query Orders, Create & Modify Orders
# Do NOT enable: Withdraw Funds
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Binance ───────────────────────────────────────────────────────────────────
# Generate at: Profile → API Management
# Permissions needed: Read Info, Enable Spot & Margin Trading
# Do NOT enable: Enable Withdrawals
# Restrict to your IP address
BINANCE_API_KEY=
BINANCE_API_SECRET=
# optional
BINANCE_PAPER_MODE=true       # false allows adapter.place_order to hit the API
BINANCE_TESTNET=false         # true + keys from https://testnet.binance.vision/
BINANCE_TLD=com                 # e.g. us for Binance.US
BINANCE_TEST_PLACE_ORDER=0    # 1 + paper false: tiny market order in test_binance.py

# ── Alpaca ────────────────────────────────────────────────────────────────────
# Generate at: Paper Trading → Your API Keys (separate from live keys)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_MODE=true
# Optional smoke test: ALPACA_TEST_PLACE_ORDER=1 (tiny fractional market order on paper)
# ALPACA_TEST_SYMBOL=AAPL

# ── Bybit ─────────────────────────────────────────────────────────────────────
# V5 API keys; https://www.bybit.com/app/user/api-management
# BYBIT_CATEGORY=linear (USDT perps) or spot
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false           # true for testnet keys
BYBIT_CATEGORY=linear

# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres: docker compose up -d  (TimescaleDB image; values below must match compose/.env)
#
# Windows: if `docker compose exec db psql ...` works but Python fails with password errors,
# you may have Docker Postgres *and* a local Windows "postgresql" service. Both can touch
# port 5432 (e.g. IPv4 vs IPv6), so the app may connect to the wrong server. Fix: stop the
# Windows PostgreSQL service, OR give Docker a unique host port — set POSTGRES_PORT=5433 here
# (compose uses it for "host:container" mapping), then `docker compose down && docker compose up -d`.
# Verify from host (same as API): python scripts/verify_db_connection.py
# Also: python scripts/pg_check_connection.py
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mytbot
POSTGRES_USER=mytbot
POSTGRES_PASSWORD=changeme   # must match Docker Postgres — if login fails after you changed this: .\scripts\apply_postgres_password.ps1 (or reset_postgres_volume.ps1 -Force to wipe)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── AI (local-first architecture) ─────────────────────────────────────────────
# Default mode is local-first: rules + FinBERT + Ollama. No API key needed.
# Claude API is premium fallback only — enable in config/ai.yaml if desired.
ANTHROPIC_API_KEY=              # Optional: premium fallback (disabled by default)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Local AI (Ollama) ────────────────────────────────────────────────────────
# Ollama serves local LLMs via HTTP. Install: https://ollama.ai
# Default: http://localhost:11434 (set in config/ai.yaml providers.local_reasoning.base_url)
# Or use vLLM OpenAI-compatible endpoint: http://your-gpu-server:8000/v1
# OLLAMA_BASE_URL=http://localhost:11434

# ── News & Data ───────────────────────────────────────────────────────────────
NEWS_API_KEY=                   # https://newsapi.org — free tier available
POLYGON_API_KEY=                # https://polygon.io — market data (optional)
FRED_API_KEY=                   # https://fred.stlouisfed.org/docs/api — free

# ── Alerts ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=             # For trade alerts and error notifications
TELEGRAM_CHAT_ID=
# MYTBOT_DISABLE_TELEGRAM_ALERTS=0  # set 1 to suppress alerts (unit tests always suppress)
# DISCOVERY_ENABLED=0               # set 1 to enable discovery layer in run_m5
# DISCOVERY_CONFIG=config/discovery.yaml
# DISCOVERY_MAX_ANOMALIES=10
# THESIS_CACHE_MINUTES=30
# optional: python test_telegram_trade_cycle.py --paper
# TEST_TG_SYMBOL=BTC
# TEST_TG_QTY=0.001
