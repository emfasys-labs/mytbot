# .env.example
# =============
# Copy this to .env and fill in your real credentials.
# NEVER commit .env to git. It is in .gitignore.
#
# cp .env.example .env

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=paper                   # "paper" or "live" — controls all broker modes
LOG_LEVEL=INFO

# ── M1 main.py ────────────────────────────────────────────────────────────────
# Concurrent IBKR + Kraken price streams; optional Timescale tick + order logging.
# M1_ENABLE_IBKR=true
# M1_ENABLE_KRAKEN=true
# M1_IBKR_SYMBOLS=BTC
# M1_KRAKEN_SYMBOLS=BTC/USD,ETH/USD
# M1_IBKR_PLACE_ORDER=0          # 1 = after delay, one tiny paper crypto MKT (IOC) + orders row
# M1_IBKR_ORDER_DELAY_SEC=20
# M1_IBKR_ORDER_SYMBOL=BTC
# M1_IBKR_ORDER_QTY=0.001

# ── IBKR ─────────────────────────────────────────────────────────────────────
# TWS must be running locally. Enable API in TWS settings.
# APP_ENV=paper|live controls default mode in test_ibkr.py
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                  # 7497=paper, 7496=live
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=                # Your IBKR account ID (e.g. DU1234567 for paper)

# ── Kraken ────────────────────────────────────────────────────────────────────
# Generate at: Account → Security → API
# Permissions needed: Query Funds, Query Orders, Create & Modify Orders
# Do NOT enable: Withdraw Funds
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Binance ───────────────────────────────────────────────────────────────────
# Generate at: Profile → API Management
# Permissions needed: Read Info, Enable Spot & Margin Trading
# Do NOT enable: Enable Withdrawals
# Restrict to your IP address
BINANCE_API_KEY=
BINANCE_API_SECRET=
# optional
BINANCE_PAPER_MODE=true       # false allows adapter.place_order to hit the API
BINANCE_TESTNET=false         # true + keys from https://testnet.binance.vision/
BINANCE_TLD=com                 # e.g. us for Binance.US
BINANCE_TEST_PLACE_ORDER=0    # 1 + paper false: tiny market order in test_binance.py

# ── Alpaca ────────────────────────────────────────────────────────────────────
# Generate at: Paper Trading → Your API Keys (separate from live keys)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_MODE=true
# Optional smoke test: ALPACA_TEST_PLACE_ORDER=1 (tiny fractional market order on paper)
# ALPACA_TEST_SYMBOL=AAPL

# ── Future exchanges (uncomment when ready) ───────────────────────────────────
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# DERIBIT_API_KEY=
# DERIBIT_API_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres: docker compose up -d  (TimescaleDB image; values below must match compose/.env)
#
# Windows: if `docker compose exec db psql ...` works but Python fails with password errors,
# you may have Docker Postgres *and* a local Windows "postgresql" service. Both can touch
# port 5432 (e.g. IPv4 vs IPv6), so the app may connect to the wrong server. Fix: stop the
# Windows PostgreSQL service, OR give Docker a unique host port — set POSTGRES_PORT=5433 here
# (compose uses it for "host:container" mapping), then `docker compose down && docker compose up -d`.
# Verify: python scripts/pg_check_connection.py
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mytbot
POSTGRES_USER=mytbot
POSTGRES_PASSWORD=changeme   # must match the real PostgreSQL role password (or pipeline writes fail)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=              # For news classification and trade rationale

# ── News & Data ───────────────────────────────────────────────────────────────
NEWS_API_KEY=                   # https://newsapi.org — free tier available
POLYGON_API_KEY=                # https://polygon.io — market data (optional)
FRED_API_KEY=                   # https://fred.stlouisfed.org/docs/api — free

# ── Alerts ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=             # For trade alerts and error notifications
TELEGRAM_CHAT_ID=
