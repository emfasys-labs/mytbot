# .gitignore

# !! CRITICAL — never commit these !!
.env
*.key
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
*.egg

# Risk overrides (runner / dashboard persistence)
config/risk_parameter_overrides.yaml

# Data
*.csv
*.parquet
data/cache/
data/historical/
data/runtime/

# Logs
logs/
*.log

# Database
*.db
*.sqlite

# Claude / local worktrees (do not commit nested copies)
.claude/

# Node (dashboard)
node_modules/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Docker
.docker/
