# Copy to .env (same directory) and fill in. NEVER commit the real .env.
# These are read by docker-compose.yml for the IB Gateway + IBC container.

# ── IBKR credentials (required) ──────────────────────────────────────
# Use your PAPER login while TRADING_MODE=paper. Switch to the live
# login ONLY at the deliberate go-live step.
TWS_USERID=your_ib_username
TWS_PASSWORD=your_ib_password

# paper | live  — keep "paper" until you deliberately go live.
TRADING_MODE=paper

# Keep the API writable (mytbot places paper orders). The risk engine,
# kill switch and live-arming interlocks are the real safety boundary —
# not a read-only API flag.
READ_ONLY_API=no

# Time of the IBC-managed MANDATORY daily Gateway restart (local time,
# 12h clock with AM/PM as IBC expects). Pick a quiet hour. Whatever you
# set here, mirror it in the repo .env as:
#   IBKR_MAINTENANCE_WINDOWS="HH:MM-HH:MM"   (24h, ± a few minutes)
AUTO_RESTART_TIME=02:55 AM

# Olson TZ for the container (must match AUTO_RESTART_TIME's intent).
TIME_ZONE=Europe/London

# Re-login automatically if a 2FA prompt times out overnight.
RELOGIN_AFTER_2FA_TIMEOUT=yes
